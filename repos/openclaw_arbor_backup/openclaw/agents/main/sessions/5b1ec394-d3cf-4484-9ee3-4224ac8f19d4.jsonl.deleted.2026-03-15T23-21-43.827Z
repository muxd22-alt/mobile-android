{"type":"message","id":"ec382318","parentId":"5ccdef56","timestamp":"2026-03-14T19:48:55.659Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"I need to set up a proper fetching and processing script for this cron job. Let me create a comprehensive Python script that will handle fetching from YouTube, Telegram, and processing the daily briefs into your knowledge tracking system."},{"type":"text","text":"Let me create a comprehensive Python script to handle the Telegram/YouTube fetching and processing:\n\n\n"},{"type":"toolCall","id":"927168383","name":"write","arguments":{"content":"#!/usr/bin/env python3\n\"\"\"\nDaily Brief Fetcher & Processor\nFetches content from @intothecryptoverse YouTube channel and Telegram,\nthen processes daily briefs into the knowledge tracking system.\n\"\"\"\n\nimport sys\nimport os\nimport json\nimport re\nfrom datetime import datetime, timedelta\nfrom urllib.parse import urlparse, parse_qs\nfrom typing import Dict, List, Optional, Tuple\n\ntry:\n    import yt_dlp as youtube_dl\nexcept ImportError:\n    print(\"Installing yt-dlp...\")\n    sys.executable -m pip install yt-dlp -q\n    import yt_dlp\n\ntry:\n    import requests\nexcept ImportError:\n    sys.executable -m pip install requests -q\n    import requests\n\nclass DailyBriefFetcher:\n    \"\"\"\n    Fetches and processes daily briefs from @intothecryptoverse sources.\n    \"\"\"\n    \n    def __init__(self):\n        self.youtube_url = None\n        self.telegram_channel = \"@intothecryptoverse\"\n        self.cache_dir = os.path.join(os.path.dirname(__file__), 'cache')\n        os.makedirs(self.cache_dir, exist_ok=True)\n    \n    def extract_youtube_id(self, url: str) -> Optional[str]:\n        \"\"\"Extract YouTube video ID from various URL formats.\"\"\"\n        patterns = [\n            r'(?:v=|\\/)(?:(\\S)?)([\\w-]{11})',  # v=dQw4w9WgXcQ, /watch?v=VIDEO_ID\n            r'youtube\\.com\\/embed\\/([\\w-]+)',\n            r'youtube\\.com\\/shorts\\/([\\w-]+)',\n            r'youtu\\.be\\/([\\w-]+)'\n        ]\n        for pattern in patterns:\n            match = re.search(pattern, url)\n            if match:\n                return match.group(2) or match.group(1)\n        return None\n    \n    def fetch_youtube_info(self, video_id: str) -> Optional[Dict]:\n        \"\"\"\n        Fetch YouTube video metadata without downloading.\n        Returns video info including title, description, upload date, etc.\n        \"\"\"\n        try:\n            ydl_opts = {\n                'quiet': True,\n                'no_warnings': True,\n                'extract_flat': False,\n                'default_search': 'ytsearch',\n            }\n            \n            with youtube_dl.YoutubeDL(ydl_opts) as ydl:\n                info = ydl.extract_info(f'https://www.youtube.com/watch?v={video_id}', download=False)\n                \n                if not info or 'entries' not in info:\n                    return None\n                \n                entry = info['entries'][0]\n                if not entry:\n                    return None\n                \n                return {\n                    'id': entry.get('id'),\n                    'title': entry.get('title', ''),\n                    'description': entry.get('thumbnail', {}).get('url', '') or entry.get('thumbnail', b'').decode() if isinstance(entry.get('thumbnail'), bytes) else str(entry.get('thumbnail')),\n                    'duration': entry.get('duration_seconds', 0),\n                    'upload_date': entry.get('upload_date', ''),\n                    'view_count': entry.get('view_count', 0),\n                    'like_count': entry.get('like_count', 0),\n                    'tags': entry.get('tags', []),\n                    'uploader': entry.get('uploader', ''),\n                }\n        except Exception as e:\n            print(f\"Error fetching YouTube info: {e}\")\n            return None\n    \n    def fetch_youtube_transcript(self, video_id: str) -> Optional[str]:\n        \"\"\"\n        Attempt to fetch transcript/captions from YouTube.\n        Fallback to web scraping if needed.\n        \"\"\"\n        try:\n            # Method 1: Try yt-dlp transcript\n            ydl_opts = {\n                'quiet': True,\n                'writeautomaticsub': True,\n                'format': 'best',\n            }\n            \n            with youtube_dl.YoutubeDL(ydl_opts) as ydl:\n                info = ydl.extract_info(f'https://www.youtube.com/watch?v={video_id}', download=False)\n                \n                if info and 'automatic_captions' in info:\n                    captions = info['automatic_captions']\n                    for lang, caption_url in captions.items():\n                        try:\n                            resp = requests.get(caption_url)\n                            if resp.status_code == 200:\n                                return resp.text\n                        except Exception:\n                            continue\n            \n            # Method 2: Web scraping fallback\n            transcript_url = f'https://yewtu.be/api/v1/youtube/watch?v={video_id}'\n            try:\n                headers = {'User-Agent': 'Mozilla/5.0'}\n                resp = requests.get(transcript_url, headers=headers)\n                if resp.status_code == 200:\n                    data = resp.json()\n                    transcript_html = data.get('transcriptHtml', '')\n                    \n                    # Extract captions from HTML\n                    if 'captions' in transcript_html:\n                        import re as regex\n                        # Find caption tracks and extract text\n                        track_match = regex.search(r'<track id=\"([^\"]+)\"[^>]*>\n                        (<caption[^>]+>[^<]+</caption>)\n                        <', transcript_html)\n                        if track_match:\n                            return track_match.group(2)\n            except Exception as e:\n                print(f\"Transcript error: {e}\")\n        \n        except Exception as e:\n            print(f\"Error fetching transcript: {e}\")\n        return None\n    \n    def fetch_telegram_content(self, channel: str) -> List[Dict]:\n        \"\"\"\n        Fetch recent posts from Telegram channel.\n        Uses official API or unofficial scrapers as fallback.\n        \"\"\"\n        # Note: Telegram has strict anti-scraping measures\n        # Official API requires bot token\n        \n        try:\n            # Method 1: Try using Telethon (requires setup)\n            # This would require proper authentication and is beyond simple scraping\n            \n            # Method 2: Web scraper as last resort\n            telegram_url = f'https://t.me/{channel}'\n            headers = {\n                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n                'Accept': '*/*',\n                'Accept-Language': 'en-US,en;q=0.9'\n            }\n            \n            resp = requests.get(telegram_url, headers=headers)\n            if resp.status_code == 200:\n                # Parse basic channel info\n                content = {\n                    'url': f'https://t.me/{channel}',\n                    'title': f'@{channel} Channel',\n                    'type': 'telegram_channel'\n                }\n"},"partialArgs":"{\"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nDaily Brief Fetcher & Processor\\nFetches content from @intothecryptoverse YouTube channel and Telegram,\\nthen processes daily briefs into the knowledge tracking system.\\n\\\"\\\"\\\"\\n\\nimport sys\\nimport os\\nimport json\\nimport re\\nfrom datetime import datetime, timedelta\\nfrom urllib.parse import urlparse, parse_qs\\nfrom typing import Dict, List, Optional, Tuple\\n\\ntry:\\n    import yt_dlp as youtube_dl\\nexcept ImportError:\\n    print(\\\"Installing yt-dlp...\\\")\\n    sys.executable -m pip install yt-dlp -q\\n    import yt_dlp\\n\\ntry:\\n    import requests\\nexcept ImportError:\\n    sys.executable -m pip install requests -q\\n    import requests\\n\\nclass DailyBriefFetcher:\\n    \\\"\\\"\\\"\\n    Fetches and processes daily briefs from @intothecryptoverse sources.\\n    \\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        self.youtube_url = None\\n        self.telegram_channel = \\\"@intothecryptoverse\\\"\\n        self.cache_dir = os.path.join(os.path.dirname(__file__), 'cache')\\n        os.makedirs(self.cache_dir, exist_ok=True)\\n    \\n    def extract_youtube_id(self, url: str) -> Optional[str]:\\n        \\\"\\\"\\\"Extract YouTube video ID from various URL formats.\\\"\\\"\\\"\\n        patterns = [\\n            r'(?:v=|\\\\/)(?:(\\\\S)?)([\\\\w-]{11})',  # v=dQw4w9WgXcQ, /watch?v=VIDEO_ID\\n            r'youtube\\\\.com\\\\/embed\\\\/([\\\\w-]+)',\\n            r'youtube\\\\.com\\\\/shorts\\\\/([\\\\w-]+)',\\n            r'youtu\\\\.be\\\\/([\\\\w-]+)'\\n        ]\\n        for pattern in patterns:\\n            match = re.search(pattern, url)\\n            if match:\\n                return match.group(2) or match.group(1)\\n        return None\\n    \\n    def fetch_youtube_info(self, video_id: str) -> Optional[Dict]:\\n        \\\"\\\"\\\"\\n        Fetch YouTube video metadata without downloading.\\n        Returns video info including title, description, upload date, etc.\\n        \\\"\\\"\\\"\\n        try:\\n            ydl_opts = {\\n                'quiet': True,\\n                'no_warnings': True,\\n                'extract_flat': False,\\n                'default_search': 'ytsearch',\\n            }\\n            \\n            with youtube_dl.YoutubeDL(ydl_opts) as ydl:\\n                info = ydl.extract_info(f'https://www.youtube.com/watch?v={video_id}', download=False)\\n                \\n                if not info or 'entries' not in info:\\n                    return None\\n                \\n                entry = info['entries'][0]\\n                if not entry:\\n                    return None\\n                \\n                return {\\n                    'id': entry.get('id'),\\n                    'title': entry.get('title', ''),\\n                    'description': entry.get('thumbnail', {}).get('url', '') or entry.get('thumbnail', b'').decode() if isinstance(entry.get('thumbnail'), bytes) else str(entry.get('thumbnail')),\\n                    'duration': entry.get('duration_seconds', 0),\\n                    'upload_date': entry.get('upload_date', ''),\\n                    'view_count': entry.get('view_count', 0),\\n                    'like_count': entry.get('like_count', 0),\\n                    'tags': entry.get('tags', []),\\n                    'uploader': entry.get('uploader', ''),\\n                }\\n        except Exception as e:\\n            print(f\\\"Error fetching YouTube info: {e}\\\")\\n            return None\\n    \\n    def fetch_youtube_transcript(self, video_id: str) -> Optional[str]:\\n        \\\"\\\"\\\"\\n        Attempt to fetch transcript/captions from YouTube.\\n        Fallback to web scraping if needed.\\n        \\\"\\\"\\\"\\n        try:\\n            # Method 1: Try yt-dlp transcript\\n            ydl_opts = {\\n                'quiet': True,\\n                'writeautomaticsub': True,\\n                'format': 'best',\\n            }\\n            \\n            with youtube_dl.YoutubeDL(ydl_opts) as ydl:\\n                info = ydl.extract_info(f'https://www.youtube.com/watch?v={video_id}', download=False)\\n                \\n                if info and 'automatic_captions' in info:\\n                    captions = info['automatic_captions']\\n                    for lang, caption_url in captions.items():\\n                        try:\\n                            resp = requests.get(caption_url)\\n                            if resp.status_code == 200:\\n                                return resp.text\\n                        except Exception:\\n                            continue\\n            \\n            # Method 2: Web scraping fallback\\n            transcript_url = f'https://yewtu.be/api/v1/youtube/watch?v={video_id}'\\n            try:\\n                headers = {'User-Agent': 'Mozilla/5.0'}\\n                resp = requests.get(transcript_url, headers=headers)\\n                if resp.status_code == 200:\\n                    data = resp.json()\\n                    transcript_html = data.get('transcriptHtml', '')\\n                    \\n                    # Extract captions from HTML\\n                    if 'captions' in transcript_html:\\n                        import re as regex\\n                        # Find caption tracks and extract text\\n                        track_match = regex.search(r'<track id=\\\"([^\\\"]+)\\\"[^>]*>\\n                        (<caption[^>]+>[^<]+</caption>)\\n                        <', transcript_html)\\n                        if track_match:\\n                            return track_match.group(2)\\n            except Exception as e:\\n                print(f\\\"Transcript error: {e}\\\")\\n        \\n        except Exception as e:\\n            print(f\\\"Error fetching transcript: {e}\\\")\\n        return None\\n    \\n    def fetch_telegram_content(self, channel: str) -> List[Dict]:\\n        \\\"\\\"\\\"\\n        Fetch recent posts from Telegram channel.\\n        Uses official API or unofficial scrapers as fallback.\\n        \\\"\\\"\\\"\\n        # Note: Telegram has strict anti-scraping measures\\n        # Official API requires bot token\\n        \\n        try:\\n            # Method 1: Try using Telethon (requires setup)\\n            # This would require proper authentication and is beyond simple scraping\\n            \\n            # Method 2: Web scraper as last resort\\n            telegram_url = f'https://t.me/{channel}'\\n            headers = {\\n                'User-Agent': 'Mozilla/5.0 (Windows N